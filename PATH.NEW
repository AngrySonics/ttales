    {
      {-1, 1, -1, 3+ 0*5+1},
      {-1, 1,  0, 3+ 1*5+1},
      {-1, 1,  1, 3+ 2*5+1},
      {-1, 1,  2, 3+ 3*5+1},
      {-1, 1,  3, 3+ 4*5+1},
      {-1, 1,  4, 3+ 5*5+1},
      {-1, 1,  5, 3+ 6*5+1},
      {-1, 1,  6, 3+ 7*5+1},
      {-1, 1,  7, 3+ 8*5+1},
