      {-1, 1,  3, 3+ 3*5+1},
      {-1, 1,  4, 3+ 4*5+1},
      {-1, 1,  5, 3+ 5*5+1},
      {-1, 1,  6, 3+ 6*5+1},
      {-1, 1,  7, 3+ 7*5+1},
      {-1, 1,  8, 3+ 8*5+1},
      {-1, 1,  9, 3+ 9*5+1},
      {-1, 1, 10, 3+10*5+1},
      {-1, 1, 11, 3+11*5+1},
      {-1, 1, 12, 3+12*5+1},
      {-1, 1, 13, 3+13*5+1},
      {-1, 1, 14, 3+14*5+1},
      {-1, 1, 15, 3+15*5+1},
