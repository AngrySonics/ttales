      {0, 0,  5, 0+ 5*5+1}, {-1, 0,  5, 4+ 5*5+1},
      {0, 0,  6, 0+ 6*5+1}, {-1, 0,  6, 4+ 6*5+1},
      {0, 0,  7, 0+ 7*5+1}, {-1, 0,  7, 4+ 7*5+1},
      {0, 0,  8, 0+ 8*5+1}, {-1, 0,  8, 4+ 8*5+1},
      {0, 0,  9, 0+ 9*5+1}, {-1, 0,  9, 4+ 9*5+1},
