      {0, 0, 12, 0+13*5+1}, {-1, 0, 12, 4+13*5+1},
      {0, 0, 13, 0+14*5+1}, {-1, 0, 13, 4+14*5+1},
      {0, 0, 14, 0+15*5+1}, {-1, 0, 14, 4+15*5+1},
      {0, 0, 15, 0+16*5+1}, {-1, 0, 15, 4+16*5+1},
      {0, 0, 16, 0+17*5+1}, {-1, 0, 16, 4+17*5+1},
      {0, 0, 17, 0+18*5+1}, {-1, 0, 17, 4+18*5+1},
